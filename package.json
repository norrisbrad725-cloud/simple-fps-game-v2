{
  "name": "game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "dev:server": "node server/index.js",
    "build": "tsc && vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "concurrently": "^10.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "three": "^0.184.0",
    "ws": "^8.21.0"
  }
}
